<Window x:Class="PharmacyIMS.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PharmacyIMS.ViewModels"
        Title="惠民药店 药品进销存管理系统"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        mc:Ignorable="d"
        Height="420" Width="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <Border Background="White" CornerRadius="8"
            BorderThickness="1" BorderBrush="#D5D8DC">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="12" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="8"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- 顶部绿色装饰条 -->
            <Border Grid.Row="0" Grid.ColumnSpan="1" Background="#27AE60" CornerRadius="8,8,0,0"/>

            <!-- 标题区 -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="惠民药店" FontSize="26" FontWeight="Bold" Foreground="#27AE60"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="药品进销存管理系统" FontSize="13" Foreground="#95A5A6"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 分隔线 -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1"
                    Background="#EAECEE" Margin="50,0,50,0"/>

            <TextBlock Grid.Row="2" Text="用户名" Margin="60,20,0,4" FontSize="13" Foreground="#555"/>
            <TextBox Grid.Row="3" Margin="60,0,60,0" Height="36" Padding="10,8"
                     VerticalContentAlignment="Center" FontSize="14"
                     BorderThickness="1" BorderBrush="#BDC3C7"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <TextBlock Grid.Row="4" Text="密码" Margin="60,12,0,4" FontSize="13" Foreground="#555"/>
            <PasswordBox Grid.Row="5" Margin="60,0,60,0" Height="36" Padding="10,8"
                         VerticalContentAlignment="Center" FontSize="14"
                         BorderThickness="1" BorderBrush="#BDC3C7"
                         x:Name="PwdBox"
                         PasswordChanged="PwdBox_PasswordChanged"/>

            <Button Grid.Row="6" Content="登 录" Width="260" Height="38" Margin="0,22,0,0"
                    HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"
                    Foreground="White" Background="#27AE60" BorderThickness="0"
                    Cursor="Hand" Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=PwdBox}"/>

            <TextBlock Grid.Row="7" Foreground="#E74C3C" FontSize="12" HorizontalAlignment="Center"
                       Margin="0,6,0,0" Text="{Binding Message}"/>

            <!-- 底部拖拽区 -->
            <Border Grid.Row="8" Background="#F8F9F9" CornerRadius="0,0,8,8" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <TextBlock Text="可拖拽移动窗口" FontSize="10" Foreground="#BDC3C7"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
