<UserControl x:Class="PharmacyIMS.Views.PurchaseReturnListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="➕ 新增退货" Width="110" Height="32" FontSize="14" Background="#27AE60" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Command="{Binding AddCommand}"/>
            <Button Content="👁 查看" Width="90" Height="32" Margin="10,0,0,0" FontSize="14" Background="#3498DB"
                    Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding ViewCommand}"/>
            <Button Content="🗑 删除" Width="90" Height="32" Margin="10,0,0,0" FontSize="14" Background="#E74C3C"
                    Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding DeleteCommand}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="280" Height="32" Padding="6,4" FontSize="14" VerticalAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="🔍 搜索" Width="80" Height="32" Margin="8,0,0,0" FontSize="14" Command="{Binding SearchCommand}"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="13" Foreground="#7F8C8D">
            <Run Text="共"/>
            <Run Text="{Binding OrderCount}"/>
            <Run Text="笔采购退货单"/>
        </TextBlock>

        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" AlternatingRowBackground="#F5F7FA"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="退货单号" Width="140" Binding="{Binding OrderNo}"/>
                <DataGridTextColumn Header="退货日期" Width="110" Binding="{Binding ReturnDate,StringFormat={}{0:yyyy-MM-dd}}"/>
                <DataGridTextColumn Header="供应商" Width="*" Binding="{Binding Supplier.SupplierName}"/>
                <DataGridTextColumn Header="总金额" Width="100" Binding="{Binding TotalAmount,StringFormat={}{0:N2}}"/>
                <DataGridTextColumn Header="操作人" Width="90" Binding="{Binding OperatorName}"/>
                <DataGridTextColumn Header="状态" Width="80" Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
