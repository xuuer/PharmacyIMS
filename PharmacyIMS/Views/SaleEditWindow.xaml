<Window x:Class="PharmacyIMS.Views.SaleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:PharmacyIMS.Helpers"
        Title="{Binding WindowTitle}" Height="560" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <helpers:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="销售单号：" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Order.OrderNo}" Height="28" IsReadOnly="True" Background="#F5F5F5"/>
            <TextBlock Grid.Column="2" Text="销售日期：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <DatePicker Grid.Column="3" SelectedDate="{Binding Order.SaleDate}" Height="28" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"/>
            <TextBlock Grid.Column="4" Text="客户：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox Grid.Column="5" Text="{Binding Order.CustomerName}" Height="28" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="销售明细" FontSize="14" FontWeight="Bold" Margin="0,12,0,6"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="➕ 添加药品" Width="100" Height="28" Background="#27AE60" Foreground="White" BorderThickness="0"
                    Command="{Binding AddDetailCommand}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"/>
            <Button Content="➖ 移除选中" Width="100" Height="28" Margin="8,0,0,0" Background="#E74C3C" Foreground="White" BorderThickness="0"
                    Command="{Binding RemoveDetailCommand}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"/>
        </StackPanel>

        <DataGrid x:Name="SaleDetailsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  ItemsSource="{Binding Details}" SelectedItem="{Binding SelectedDetail}"
                  IsReadOnly="{Binding IsReadOnly}"
                  AlternatingRowBackground="#F5F7FA"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="药品名称" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Medicine.MedicineName}" Padding="4,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Medicines, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="MedicineName" SelectedValuePath="Id"
                                      SelectedValue="{Binding MedicineId, UpdateSourceTrigger=PropertyChanged}"
                                      Height="24" VerticalAlignment="Center"
                                      SelectionChanged="MedicineComboBox_SelectionChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="数量" Width="80" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="单价" Width="90" Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}"/>
                <DataGridTextColumn Header="小计" Width="90" Binding="{Binding SubTotal, StringFormat={}{0:N2}}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Text="总金额：" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Order.TotalAmount,StringFormat={}{0:N2}}" FontSize="18" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center"/>
            <TextBlock Text=" 元" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="保存" Width="100" Height="34" Background="#27AE60" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}" Margin="0,0,10,0"/>
            <Button Content="取消" Width="100" Height="34" Background="#95A5A6" Foreground="White" BorderThickness="0"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
