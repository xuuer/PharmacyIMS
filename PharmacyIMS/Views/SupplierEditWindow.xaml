<Window x:Class="PharmacyIMS.Views.SupplierEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="360" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="供应商名称：" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Supplier.SupplierName}" Height="28" Padding="4,2"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="联系人：" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Supplier.ContactPerson}" Height="28" Padding="4,2"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="联系电话：" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Supplier.Phone}" Height="28" Padding="4,2"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="地址：" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Supplier.Address}" Height="28" Padding="4,2"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="许可证号：" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Supplier.LicenseNo}" Height="28" Padding="4,2"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="是否启用：" VerticalAlignment="Center" Margin="0,6"/>
        <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding Supplier.IsActive}" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="保存" Width="100" Height="34" Background="#27AE60" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}" Margin="0,0,10,0"/>
            <Button Content="取消" Width="100" Height="34" Background="#95A5A6" Foreground="White" BorderThickness="0"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
