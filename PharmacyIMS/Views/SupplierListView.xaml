<UserControl x:Class="PharmacyIMS.Views.SupplierListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="➕ 新增供应商" Width="120" Height="32" FontSize="14" Background="#27AE60" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Command="{Binding AddCommand}"/>
            <Button Content="✏ 编辑" Width="90" Height="32" Margin="10,0,0,0" FontSize="14" Background="#3498DB"
                    Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding EditCommand}"/>
            <Button Content="🗑 删除" Width="90" Height="32" Margin="10,0,0,0" FontSize="14" Background="#E74C3C"
                    Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding DeleteCommand}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="280" Height="32" Padding="6,4" FontSize="14" VerticalAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="🔍 搜索" Width="80" Height="32" Margin="8,0,0,0" FontSize="14" Command="{Binding SearchCommand}"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="13" Foreground="#7F8C8D">
            <Run Text="共"/>
            <Run Text="{Binding SupplierCount}"/>
            <Run Text="家供应商"/>
        </TextBlock>

        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" AlternatingRowBackground="#F5F7FA"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="供应商名称" Width="*" Binding="{Binding SupplierName}"/>
                <DataGridTextColumn Header="联系人" Width="100" Binding="{Binding ContactPerson}"/>
                <DataGridTextColumn Header="电话" Width="120" Binding="{Binding Phone}"/>
                <DataGridTextColumn Header="地址" Width="*" Binding="{Binding Address}"/>
                <DataGridTextColumn Header="许可证号" Width="*" Binding="{Binding LicenseNo}"/>
                <DataGridTextColumn Header="状态" Width="80" Binding="{Binding IsActive}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
